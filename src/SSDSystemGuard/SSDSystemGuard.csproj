<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>SSDSystemGuard</AssemblyName>
    <RootNamespace>SSDSystemGuard</RootNamespace>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\SSDSystemGuard.ico</ApplicationIcon>

    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>

    <Authors>SSD System Guard contributors</Authors>
    <Description>Windows utility that helps keep game downloads and new installs off the system SSD.</Description>
    <RepositoryUrl>https://github.com/Leonardorobertomotalvao/ssd-system-guard</RepositoryUrl>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.ps1" />
    <EmbeddedResource Include="assets\SSDSystemGuard.ico">
      <LogicalName>SSDSystemGuard.Resources.SSDSystemGuard.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
